# Copy to .env for local development. Never commit real values.
# In Netlify these are set as environment variables per deploy context
# (production -> Neon `main` branch, branch-deploy -> Neon `dev` branch).

APP_ENV=development              # development | dev | production
DATABASE_URL=postgres://postgres@localhost:5432/proserve?host=/tmp
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# OTP: "dev" shows the code on screen (blocked when APP_ENV=production); "msg91" sends real SMS
OTP_MODE=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments: "mock" simulates payment (blocked when APP_ENV=production); "razorpay" for real payments
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
